{
  "name": "kipo",
  "version": "0.1.0",
  "displayName": "KiPo",
  "description": "Matt Pocock's engineering flow for your repos: each effort's tickets as tiles in two lanes, Decide and Deliver, with the next step on top and a conversation per ticket that runs the right Pocock skills. Open wayfinder maps from your repos as efforts.",
  "author": "masterphelps",
  "iconPath": "assets/icon.png",
  "skills": [
    "skills/kipo-intake",
    "skills/kipo-shape",
    "skills/kipo-grill",
    "skills/kipo-plan",
    "skills/kipo-build",
    "skills/kipo-review",
    "skills/kipo-done"
  ],
  "tags": [
    "planning",
    "workflow",
    "developer-tools",
    "mattpocock",
    "skills"
  ],
  "backend": {
    "entryPoint": "backend/server.py",
    "port": "auto",
    "healthCheck": "/health"
  },
  "ui": {
    "entry": "dist/index.mjs",
    "pages": [
      {
        "route": "/apps/kipo",
        "label": "KiPo",
        "icon": "FlaskConical"
      }
    ]
  },
  "dependencies": {
    "commands": [
      "gh",
      "git"
    ]
  },
  "permissions": {
    "api": [
      "/api/chat",
      "/api/chat/*"
    ],
    "events": [
      "slots"
    ],
    "storage": true,
    "network": true,
    "sessionApproval": true
  }
}
